{
  "name": "pi-static-working-indicator",
  "version": "0.1.0",
  "description": "Replace Pi's animated working spinner with a static dot, so long sessions stop re-rendering while the agent waits.",
  "keywords": ["pi-package"],
  "license": "MIT",
  "author": "Felix Rath (futile)",
  "contributors": ["fdietze"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdietze/pi-static-working-indicator.git"
  },
  "type": "module",
  "files": ["extensions/static-working-indicator.ts"],
  "pi": {
    "extensions": ["extensions/static-working-indicator.ts"]
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "oxlint extensions scripts",
    "test": "node --test extensions/*.test.ts scripts/*.test.ts",
    "publish:ci": "node scripts/publish.ts",
    "ci": "actionlint -ignore '^unexpected key \"queue\" for \"concurrency\" section\\.' && npm run typecheck && npm run lint && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22"
  }
}
